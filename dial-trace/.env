# ELK baglantisi
# Dogrudan Elasticsearch erisimin varsa (genelde 9200):
#   ELK_URL=http://10.12.103.16:9200   ve   ELK_VIA_KIBANA=false
# Sadece Kibana erisimin varsa (5601):
#   ELK_URL=http://10.12.103.16:5601   ve   ELK_VIA_KIBANA=true
ELK_URL=http://10.12.103.16:5601
ELK_VIA_KIBANA=true
ELK_INDEX=nonturkcell-*

# Kimlik dogrulama: ya USER/PASS ya da API_KEY doldur (birini).
# Kibana modunda USER/PASS = Kibana login bilgilerin.
ELK_USER=BS
ELK_PASS=Bsantral2024
ELK_API_KEY=

# Self-signed sertifika varsa false birak
ELK_VERIFY_SSL=false

# Sorgu sabitleri
APPLICATION_NAME=Powerdialer
TIME_WINDOW=now-30d